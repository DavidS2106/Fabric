# ======================================================================
# FILE CAPABILITY ENVIRONMENT
# ----------------------------------------------------------------------
# Copy to File/config/connection/.env and edit. Values already defined
# in the process or the CI environment always win over this file.
#
# The Fabric SQL connection is NOT repeated here. It lives in
# config/connections/targets.yml under the name `fabric`, driven by the
# FABRIC_SQL_* variables in config/connections/.env, and target.yml reaches
# it through `connection_reference: fabric`.
# ======================================================================

# ----------------------------------------------------------------------
# Local file source (connection: local_file) — REQUIRED
# ----------------------------------------------------------------------
FILE_SOURCE_ROOT=File/source


# ----------------------------------------------------------------------
# Fabric Lakehouse file target (connection: fabric_lakehouse_file)
# REQUIRED — all four, plus the onelake_account_url literal already in
# target.yml. A table using this connection reports a configuration error
# naming whichever of them is missing.
# ----------------------------------------------------------------------
FABRIC_RAW_SQL_ENDPOINT=<lakehouse>.datawarehouse.fabric.microsoft.com
FABRIC_RAW_WORKSPACE=ws_insrc_data_dev
FABRIC_RAW_LAKEHOUSE=lh_brz_dev
FABRIC_RAW_AUTHENTICATION=ActiveDirectoryInteractive


# ----------------------------------------------------------------------
# Fabric Lakehouse file target — OPTIONAL
# ----------------------------------------------------------------------

# Folder inside the lakehouse that a target's relative_path is resolved
# from. Unset, relative_path resolves from the lakehouse root.
FABRIC_RAW_LAKEHOUSE_PATH=Files/bronze

# Read the lakehouse through an existing mount instead of OneLake (a Fabric
# notebook mounts it under /lakehouse/default).
# FABRIC_RAW_LOCAL_MOUNT=/lakehouse/default

# Only needed when a fabric_sql_table target names this connection, so the
# lakehouse's own SQL analytics endpoint serves it.
# FABRIC_RAW_DATABASE=lh_brz_dev
# FABRIC_RAW_DRIVER=ODBC Driver 17 for SQL Server
